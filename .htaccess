# 1) FORCAR HTTPS
RewriteEngine On

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# 2) PADRONIZAR WWW PARA SEM WWW
RewriteCond %{HTTP_HOST} ^www\.([^:]+)(?::[0-9]+)?$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# 3) URL LIMPA
# Regra A: redirecionar requisicoes diretas a index.html para a URL canonica.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]) [NC]
RewriteRule ^index\.html$ / [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+(.+)/index\.html(?:[\s?]) [NC]
RewriteRule ^(.+)/index\.html$ /$1 [R=301,L,NE]

# Regra A: remover .html somente quando ele veio na requisicao do navegador.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[\s?]) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

# Canonicalizar a barra final quando existir um arquivo .html equivalente.
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

# Regra B: servir internamente o arquivo .html para a URL sem extensao.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# 4) PAGINA 404
ErrorDocument 404 /404.html

# 5) COMPRESSAO GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/x-javascript image/svg+xml application/xml text/xml application/rss+xml font/ttf font/otf font/woff font/woff2 application/vnd.ms-fontobject application/font-woff application/font-woff2 application/x-font-ttf application/x-font-opentype
</IfModule>

# 6) CACHE QUASE ZERADO
<IfModule mod_headers.c>
    <FilesMatch "\.html?$">
        Header always set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    <FilesMatch "\.(?:css|js|mjs|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf|eot)$">
        Header always set Cache-Control "max-age=3600"
    </FilesMatch>
</IfModule>
